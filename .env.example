# Lioran—Tokyo local service
PORT=8787

# Reuse the already-deployed local Hermes / AlinGPT from
# https://github.com/Jianheng71/Lioran (one-time machine setup).
# Do not download or vendor a model into this repo.
# Default points at that local service; leave as-is if Hermes is already running.
HERMES_BASE_URL=http://127.0.0.1:43127
HERMES_MODEL=hermes3:8b
HERMES_TIMEOUT_MS=60000

# Pinned HyperFrames CLI version — do not bump
HYPERFRAMES_VERSION=0.9.32

# Timeouts
CRAWL_TIMEOUT_MS=45000
RENDER_TIMEOUT_MS=600000

# Retention: keep the newest N job directories under data/jobs (0 = keep all)
JOB_RETENTION=20

# Optional Chrome path for crawler / HyperFrames (leave empty to auto-detect)
# CHROME_PATH=
