# Lioran—Tokyo local service
PORT=8787

# OpenAI-compatible Hermes / LLM base URL (already deployed on the host).
# Do not download or vendor a model into this repo.
# Doctor probes GET {HERMES_BASE_URL}/v1/models — that path must return model JSON, not HTML.
#
# The value below is only a starting guess. On some machines 43127 is a different
# app (for example a Next.js page) and /v1/models returns 404. In that case set
# HERMES_BASE_URL to the working local OpenAI-compatible address. One common
# example is http://127.0.0.1:11434 when Ollama is serving hermes3:8b there —
# verify GET /v1/models on your machine; do not assume 43127 or 11434 everywhere.
HERMES_BASE_URL=http://127.0.0.1:43127
HERMES_MODEL=hermes3:8b
HERMES_TIMEOUT_MS=60000

# Pinned HyperFrames CLI version — do not bump
HYPERFRAMES_VERSION=0.9.32

# Timeouts
CRAWL_TIMEOUT_MS=45000
RENDER_TIMEOUT_MS=600000

# Retention: keep the newest N job directories under data/jobs (0 = keep all)
JOB_RETENTION=20

# Chrome / Chromium for Crawlee + HyperFrames.
# Leave empty to auto-detect common install paths / PATH names.
# If Puppeteer reports “Failed to launch browser”, set this explicitly, e.g.:
# CHROME_PATH=/usr/bin/google-chrome-stable
# CHROME_PATH=/usr/bin/chromium
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=
